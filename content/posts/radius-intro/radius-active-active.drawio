        </mxCell>
        <mxCell id="dbCloud" value="PostgreSQL&#10;(Azure PaaS Recipe)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;boundedLbl=1" vertex="1" parent="1">
          <mxGeometry x="150" y="425" width="160" height="70" as="geometry" />
