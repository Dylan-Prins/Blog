        <mxCell id="radCloud" value="Radius Application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=top;fontSize=12;fontStyle=1;dashed=1" vertex="1" parent="1">
