        <mxCell id="afd" value="Azure Front Door&#10;(global routing &amp; failover)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#005a9e;fontColor=#ffffff;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="240" height="56" as="geometry" />
